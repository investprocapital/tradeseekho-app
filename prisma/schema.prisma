// TradeSeekho v1.0 - Forex & Crypto Learning Platform
// Prisma schema (SQLite for local dev; portable to Neon Postgres for production)
// Multi-language content: English / Urdu / Hindi / Arabic (Urdu + Arabic are RTL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Learning content ----------

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique // beginner | intermediate | advanced
  nameEn        String
  nameUr        String
  nameHi        String
  nameAr        String
  descriptionEn String?
  descriptionUr String?
  descriptionHi String?
  descriptionAr String?
  icon          String?  // lucide icon name
  color         String?  // brand accent hex
  order         Int      @default(0)
  lessons       Lesson[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lesson {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  titleEn     String
  titleUr     String
  titleHi     String
  titleAr     String
  summaryEn   String?
  summaryUr   String?
  summaryHi   String?
  summaryAr   String?
  contentEn   String   // markdown-ish rich text
  contentUr   String
  contentHi   String
  contentAr   String
  imageUrl    String?
  durationMin Int      @default(5)
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  isFree      Boolean  @default(true)
  quiz        Quiz?
  progress    Progress[]
  bookmarks   Bookmark[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Quiz {
  id        String    @id @default(cuid())
  lessonId  String    @unique
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passMark  Int       @default(3) // out of total; need >= passMark to unlock next lesson
  questions Question[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// SQLite disallows scalar lists, so MCQ options are stored as 4 option columns.
// option3/option4 nullable so True/False questions can omit them.
model Question {
  id             String   @id @default(cuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type           String   @default("MCQ") // MCQ | TF
  promptEn       String
  promptUr       String
  promptHi       String
  promptAr       String
  option1En      String
  option1Ur      String
  option1Hi      String
  option1Ar      String
  option2En      String
  option2Ur      String
  option2Hi      String
  option2Ar      String
  option3En      String?
  option3Ur      String?
  option3Hi      String?
  option3Ar      String?
  option4En      String?
  option4Ur      String?
  option4Hi      String?
  option4Ar      String?
  correctIndex   Int      // 0-based index of the correct option
  explanationEn  String?
  explanationUr  String?
  explanationHi  String?
  explanationAr  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([quizId])
}

// ---------- Users, progress, bookmarks ----------

model User {
  id              String     @id @default(cuid())
  email           String?    @unique // nullable for anonymous local learners; unique for auth
  name            String?
  image           String?    // avatar (Google) or null
  password        String?    // bcrypt hash for email/password auth; null for OAuth/local
  role            String     @default("student") // student | admin
  proStatus       String     @default("none") // none | pending | active (manual payment approval)
  proPlans        String     @default("") // comma-separated: "alerts" | "lessons" | "signals" | "alerts,lessons" etc.
  isProLessons    Boolean    @default(false) // true = all lessons unlocked
  isProAlerts     Boolean    @default(false) // true = unlimited price alerts
  isProSignals    Boolean    @default(false) // true = premium signals unlocked
  proExpiresAt    DateTime?  // optional expiry; null = lifetime
  fcmToken        String?    // Firebase Cloud Messaging token (for push notifications when app is closed)
  preferredLang   String?    // en | ur | hi | ar — saved per-user, auto-applied on login
  lessonsCompleted Int     @default(0) // cumulative count of lessons passed (for ad interstitial cadence)
  resetToken      String?   // password reset token
  resetTokenExpiry DateTime? // when reset token expires
  progress        Progress[]
  bookmarks       Bookmark[]
  certificates    Certificate[]
  proRequests     ProRequest[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Manual Pro payment request: user uploads a payment screenshot, admin approves.
model ProRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method         String   // "JazzCash" | "Easypaisa" | "Card" | "SadaPay" | "USDT" | "USDT_BEP20"
  amount         Int      @default(0) // PKR; optional info from user
  screenshotPath String   // CDN URL (Vercel Blob) or base64 data URL
  txHash         String?  // Transaction Hash / TxID (crypto payments) — separate from note
  note           String?  // optional user note (NOT the tx hash — that's in txHash)
  planType       String   @default("all") // all | lessons | alerts | signals — what the client paid for
  status         String   @default("pending") // pending | approved | rejected
  reviewedAt     DateTime?
  reviewerNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  score     Int      @default(0)
  total     Int      @default(0)
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// Certificate issued when a learner passes every lesson in a level (category).
// verificationId is a short public code for shareable proof (also used by Flutter).
model Certificate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categorySlug   String   // e.g. "beginner"
  userName       String   @default("TradeSeekho Learner")
  lessonsPassed  Int      // snapshot of how many lessons were in the level
  totalLessons   Int
  scoreSum       Int      // sum of best quiz scores across the level
  scoreTotal     Int      // sum of total questions across the level
  verificationId String   @unique // short public code, e.g. "TS-AB12CD"
  issuedAt       DateTime @default(now())

  @@unique([userId, categorySlug])
}

// ---------- App configuration (singletons) ----------

model AdSettings {
  id                   String   @id @default("singleton")
  // Legacy (kept for backward compat)
  bannerEnabled        Boolean  @default(true)
  interstitialEnabled  Boolean  @default(true)
  bannerUnitId         String   @default("ca-app-pub-DEMO/BANNER")
  interstitialUnitId   String   @default("ca-app-pub-DEMO/INTERSTITIAL")
  // New ad network switches
  admobEnabled         Boolean  @default(false)  // Native App Ads (APK/Play Store) — Default OFF
  adsenseEnabled       Boolean  @default(true)   // Web Ads (PC/Mobile Browser/iPhone) — Default ON
  autoMode             Boolean  @default(true)   // Auto Switch Mode — one network at a time
  adFrequency          Int      @default(4)      // Show ad every N questions
  // Signal screen bottom banner ad
  signalBottomAd       Boolean  @default(true)   // ON/OFF toggle for signal list bottom ad
  signalBottomAdUnitId String   @default("ca-app-pub-DEMO/SIGNAL_BANNER") // AdMob/AdSense unit ID
  // Comments section on signal detail page — global ON/OFF toggle.
  // When OFF: hides the entire comments section + blocks DB writes to Comment table.
  commentsEnabled      Boolean  @default(true)
  // Google Login button ON/OFF — admin can hide/show the "Continue with Google"
  // button on the login page from the admin panel.
  googleLoginEnabled   Boolean  @default(true)
  // Price Alerts feature ON/OFF — admin can enable/disable the entire
  // Price Alerts section (button on home + alerts sheet).
  priceAlertsEnabled   Boolean  @default(true)
  // Reviews section ON/OFF — admin can show/hide "What Students Say" on home
  reviewsEnabled       Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Broker banner ads — 3 rotating ads, admin-editable
model BrokerAd {
  id        String   @id @default(cuid())
  slot      Int      @unique // 1, 2, 3
  name      String   @default("Broker Ad")
  text      String   @default("Trade with Exness - Instant Deposit & Withdrawal")
  btnText   String   @default("Open Account")
  link      String   @default("#")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pro payment settings — editable from Admin Panel
model ProSettings {
  id              String   @id @default("singleton")
  usdPrice        Float    @default(5)     // Price in USD
  pkrRate         Float    @default(280)   // 1 USD = X PKR (admin editable)
  jazzcashNumber  String   @default("03XX-XXXXXXX")
  easypaisaNumber String   @default("03XX-XXXXXXX")
  cardEnabled     Boolean  @default(true)  // Show Visa/Debit Card option
  cardInstructions String  @default("Contact admin on WhatsApp for card payment link")
  // SadaPay — for international/worldwide clients
  sadapayEnabled  Boolean  @default(true)
  sadapayName     String   @default("TradeSeekho PK")
  sadapayNumber   String   @default("03XX-XXXXXXX")
  sadapayIban     String   @default("PK36SAPK0000000000000000")
  // USDT TRC20 (Binance) — crypto payment via Tron network
  usdtEnabled     Boolean  @default(true)
  usdtAddress     String   @default("Paste your TRC20 wallet address here")
  // USDT BEP20 (BSC) — crypto payment via BNB Smart Chain
  bep20Enabled    Boolean  @default(true)
  bep20Address    String   @default("0xaa889030e6e69ef3eb55a2e94f1226628a8a19c3")
  // Payoneer — email transfer payment (like USDT but via Payoneer email)
  payoneerEnabled   Boolean  @default(false)
  payoneerEmail     String   @default("")
  payoneerInstructions String @default("")
  updatedAt       DateTime @updatedAt
}

// Admin-editable static pages (About Us, Privacy Policy, Contact Us)
model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique // about-us | privacy-policy | contact-us
  title     String
  content   String   // markdown/text content
  updatedAt DateTime @updatedAt
}

// Trading signals — admin creates, clients view
// status flow: active -> tp1_hit -> tp2_hit -> tp3_hit (win) OR -> sl_hit (loss) OR -> closed
model Signal {
  id          String   @id @default(cuid())
  symbol      String   // OANDA:XAUUSD | BINANCE:BTCUSDT | TVC:USOIL | FX:EURUSD | FX:GBPUSD
  signalType  String   // BUY | SELL
  entry       String   // e.g. "1.0950" — Entry Price 1 (From)
  entry2      String?  // e.g. "1.0970" — Entry Price 2 (To). When set, client shows Entry Zone.
  stopLoss    String   // e.g. "1.0930"
  tp1         String?
  tp2         String?
  tp3         String?
  note        String?
  screenshot  String   // base64 data URL of chart screenshot
  status      String   @default("active") // active | tp1_hit | tp2_hit | tp3_hit | sl_hit | closed
  // Timestamps for each TP/SL hit (null = not yet hit). Phase 1 = manual button.
  tp1HitAt    DateTime?
  tp2HitAt    DateTime?
  tp3HitAt    DateTime?
  slHitAt     DateTime?
  // Optional profit snapshot (USD) recorded at the moment of the hit, for display.
  profitUsd   Int?
  // When true, the client hides Entry/SL/TP values + only shows the chart image.
  // Used for "chart-only" signals where the admin doesn't want to share levels.
  hideLevels  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications Notification[]
  comments      Comment[]

  @@index([status])
}

// Broadcast notifications — one row is seen by ALL users (Phase 1 manual system).
// Used for signal TP/SL hit alerts. Per-user read tracking is a future update.
// deepLink follows the app:// scheme, e.g. app://signal/{signalId}
model Notification {
  id        String   @id @default(cuid())
  type      String   @default("signal") // signal | system
  title     String
  body      String
  deepLink  String?  // app://signal/{id}
  signalId  String?
  signal    Signal?  @relation(fields: [signalId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Signal comments — users post text + optional image (chart screenshot) under
// each signal. By default, new comments are HIDDEN — admin must manually approve
// (show) them. This prevents spam/inappropriate content from appearing publicly.
// Likes are a simple counter (no per-user tracking in Phase 1). Reports flag
// comments for admin review.
model Comment {
  id        String   @id @default(cuid())
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  userId    String
  userName  String   @default("Anonymous")
  text      String
  image     String?  // base64 data URL (compressed, max ~200KB)
  hidden    Boolean  @default(true) // new comments start hidden — admin approves
  likes     Int      @default(0)
  reports   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([signalId])
  @@index([hidden])
}

// Price alerts — users set a target price for a symbol. When the live market
// price crosses the target, a notification is sent. Phase 1: manual check via
// API (no background cron). Phase 2: FCM push notifications.
model PriceAlert {
  id           String   @id @default(cuid())
  userId       String
  symbol       String   // OANDA:XAUUSD | BINANCE:BTCUSDT | etc.
  targetPrice  Float    // the price the user wants to be alerted at
  direction    String   @default("above") // above | below
  triggered    Boolean  @default(false) // true once the alert fires
  createdAt    DateTime @default(now())
  triggeredAt  DateTime?

  @@index([userId])
  @@index([symbol])
}

model AppStats {
  id             String  @id @default("singleton")
  totalDownloads Int     @default(0)
  activeUsers    Int     @default(0)
  totalLessons   Int     @default(0)
  totalQuizzes   Int     @default(0)
  updatedAt      DateTime @updatedAt
}

// Custom Affiliate Ad Banner — single configurable banner shown at the bottom
// of the Lessons page and the Live Signals page. Admin controls everything via
// the "Affiliate Ads" tab in the admin panel: on/off toggle, title, description,
// button text, logo image (left), banner image (right), and the affiliate link.
// Clicking the ad opens the affiliate link in a new tab. Stored as a singleton
// (id = "singleton") like AppStats — only one ad configuration exists at a time.
model AffiliateAd {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false) // main on/off switch
  title       String   @default("Mexc") // e.g. "Mexc", "Binance", "Bybit"
  description String   @default("Make your first deposit and Futures trade to unlock rewards")
  buttonText  String   @default("Download") // red CTA button text
  logoUrl     String?  // left-side brand logo image (CDN URL or base64)
  bannerUrl   String?  // right-side promotional banner image (CDN URL or base64)
  link        String   @default("#") // affiliate link (opens in new tab)
  updatedAt   DateTime @updatedAt
}
