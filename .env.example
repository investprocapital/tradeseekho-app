# ─────────────────────────────────────────────────────────────
# TradeSeekho — environment variables (copy to .env / Vercel env)
# ─────────────────────────────────────────────────────────────

# Database ────────────────────────────────────────────────────
# LOCAL DEV (SQLite):  keep provider = "sqlite" in prisma/schema.prisma
DATABASE_URL="file:./db/custom.db"

# PRODUCTION (Neon Postgres):
#   1. In prisma/schema.prisma change:  provider = "postgresql"
#   2. Set DATABASE_URL to your Neon connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/tradeseekho?sslmode=require"

# Admin panel auth (password gate, HMAC-signed httpOnly cookie)
ADMIN_PASSWORD="tradeseekho"
ADMIN_PASSWORD_SECRET="change-me-to-a-long-random-string"

# NextAuth (Email + Google login) — required on Vercel for the login dialog to work
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://tradeseekho-app.vercel.app"

# Owner admin account (auto-provisioned on first login attempt with these creds)
# When a user signs in with this exact email+password and the user doesn't exist
# in the DB yet, they're created with role=admin automatically — no seed script needed.
ADMIN_EMAIL="imranpti588@gmail.com"
ADMIN_PASSWORD_USER="seekhomjse_49A"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI must include:  https://tradeseekho-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="576801907902-gi4aaslkaign7vi5gbndrehigo2m319r.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""  # ← Add your Client Secret here (from Google Cloud Console)
