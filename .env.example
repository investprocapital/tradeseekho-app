# ─────────────────────────────────────────────────────────────
# TradeSeekho — environment variables (copy to .env / Vercel env)
# ─────────────────────────────────────────────────────────────

# Database ────────────────────────────────────────────────────
# LOCAL DEV (SQLite):  keep provider = "sqlite" in prisma/schema.prisma
DATABASE_URL="file:./db/custom.db"

# PRODUCTION (Neon Postgres):
#   1. In prisma/schema.prisma change:  provider = "postgresql"
#   2. Set DATABASE_URL to your Neon connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/tradeseekho?sslmode=require"

# Admin panel auth (password gate, HMAC-signed httpOnly cookie)
ADMIN_PASSWORD="tradeseekho"
ADMIN_PASSWORD_SECRET="change-me-to-a-long-random-string"

# NextAuth (if you upgrade the password gate to NextAuth + Clerk/Google)
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="https://your-vercel-app.vercel.app"
